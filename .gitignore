# ============================================================
# dsh-tui 配置目录 .gitignore
# 原则: 只版本化“配置/定制”内容(model.json、theme.json、
# themes/、patches/ 等)，运行时状态、日志、会话数据不入库。
# ============================================================

# ---- 会话与历史数据(含对话内容，属个人数据) ----
history.jsonl
session-index.json
# 列表首屏快照：与 session-index.json 同源，行里带会话标题
session-lists/
resume.txt

# ---- 运行时状态 ----
last-used.json
agent-view-sessions.json
session-mounts.json
home.json
usage.json

# ---- 日志 / 账本 ----
effect-ledger.jsonl
restart.log

# ---- 补丁脚本的运行时状态(diff 落库指纹)与临时工作区 ----
patches/state/
patches/.tmp.*

# ---- 注入(inject)运行时：活动进程注册表 + unix socket ----
inject/servers.json
inject/*.sock
